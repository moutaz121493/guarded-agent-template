AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=8081
# mock (zero-cost offline demo/CI) | anthropic | groq / openai (any OpenAI-compatible API)
AGENT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# groq/openai provider (Groq free tier by default; cost = real token usage x your prices, 0 on a free tier)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
# 1 = the model phrases the final answer in the user's language (EN/DE/AR) from the tool facts only
LLM_ANSWER=0
# Real deployments: read-only health snapshot dir (services.json [+ status.json]), your own KB file,
# and RESTART_MODE=dry-run so approved restarts are reported but never executed
HEALTH_SNAPSHOT_DIR=
HEALTH_STATUS_PATH=
KB_PATH=
RESTART_MODE=mock
# Real maintenance backend + admin keyword for chat channels (see README)
MAINT_URL=
ADMIN_KEYWORD=
ADMIN_CHANNELS=whatsapp,telegram
APPROVAL_TTL_SECONDS=600
DAILY_BUDGET_USD=1.00
MONTHLY_BUDGET_USD=10.00
